# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env.production)
# ==========================================
# Copy this file to hurshbintech-backend/.env.production and fill in the values

# -------------------- Database Configuration --------------------
# RDS PostgreSQL connection details
DB_USER=postgres
DB_PASSWORD=your_rds_master_password_here
DB_HOST=hurshbintech-db.xxxxx.ap-south-1.rds.amazonaws.com  # Replace with your RDS endpoint
DB_PORT=5432
DB_NAME=hurshbintechdb

# -------------------- Security Configuration --------------------
# Generate a new secret key: openssl rand -hex 32
SECRET_KEY="your_generated_secret_key_here"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------- CORS Configuration --------------------
# Add your domain/IP addresses
BACKEND_CORS_ORIGINS=["http://43.204.218.16","http://localhost:3000","https://yourdomain.com"]

# -------------------- AWS S3 Configuration --------------------
# IAM user credentials for S3 access
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1  # Mumbai region, change if using different region
S3_BUCKET_NAME=hurshbintech-media-123456  # Replace with your bucket name

# -------------------- Application Configuration --------------------
# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env.production)
# ==========================================
# Copy this file to hurshbintech-frontend/.env.production and fill in the values

# -------------------- API Configuration --------------------
# Backend API base URL (use your EC2 public IP or domain)
VITE_API_BASE_URL=http://43.204.218.16/api
# WebSocket URL
VITE_WS_URL=ws://43.204.218.16/ws
# API request timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ==========================================
# NOTES
# ==========================================
# 1. Never commit .env.production files to Git
# 2. Keep all credentials secure
# 3. Update BACKEND_CORS_ORIGINS after adding domain
# 4. Use HTTPS URLs in production with SSL certificate
# 5. Generate a new SECRET_KEY using: openssl rand -hex 32
# 6. RDS endpoint is available in AWS Console > RDS > Databases
# 7. S3 bucket name must be globally unique
