# Backend Environment Configuration

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://hurshbinuser:yourpassword@localhost:5432/hurshbintechdb
# OR use individual fields:
# DB_USER=hurshbinuser
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hurshbintechdb

# Security Settings
# IMPORTANT: Generate a strong secret key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Environment
ENVIRONMENT=development

# Database Settings
DB_ECHO=true

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS S3 Configuration (Optional)
USE_S3=false
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=hurshbintech-media-bucket
