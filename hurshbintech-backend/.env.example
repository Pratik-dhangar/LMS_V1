# Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Use the Docker Compose service name as the host (NOT localhost)
DATABASE_URL=postgresql://hurshbinuser:yourpassword@db-pwa:5432/hurshbintechdb_pwa
# OR use individual fields:
# DB_USER=hurshbinuser
# DB_PASSWORD=yourpassword
# DB_HOST=db-pwa
# DB_PORT=5432
# DB_NAME=hurshbintechdb_pwa

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this-in-production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-base64-encoded-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ─── CORS & Domains ──────────────────────────────────────────────────────────
# UAT:  ["https://hurshbin.lumesoftai.in:3001"]
# PROD: ["https://tech.hurshbin.com"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=https://your-frontend-domain
MEDIA_PROXY_URL=https://your-frontend-domain

# ─── Object Storage ──────────────────────────────────────────────────────────
USE_S3=false
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name
# For AWS S3 (omit this line or leave blank):
#   S3_ENDPOINT_URL=
# For Neev Cloud (set this):
#   S3_ENDPOINT_URL=https://s3-api.neevcloud.com
S3_ENDPOINT_URL=
# ─── Recording Storage ───────────────────────────────────────────────────────
# Where to save session recordings
# "local" = saves to /uploads/recordings (dev/testing only)
# "s3"    = saves to S3 bucket (production)
RECORDING_STORAGE_MODE=local
# ─── Redis Cache ─────────────────────────────────────────────────────────────
REDIS_ENABLED=true
# Use Docker Compose service name (NOT localhost)
REDIS_HOST=redis-pwa
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
