# Backend Environment Configuration - PRODUCTION

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://hurshbinuser:STRONG_PASSWORD@localhost:5432/hurshbintechdb

# Security Settings
# CRITICAL: Use a strong random key (min 32 characters)
# Generate using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Environment
ENVIRONMENT=production

# Database Settings
DB_ECHO=false

# CORS Origins (comma-separated, include all production URLs)
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://43.204.218.16,https://43.204.218.16:3000

# AWS S3 Configuration
USE_S3=true
AWS_ACCESS_KEY_ID=your-production-aws-access-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=hurshbintech-media-bucket
S3_ENDPOINT_URL=

# Recording Storage Mode
# Set to "s3" to save video recordings to S3 bucket
# Set to "local" to save to /uploads/recordings (testing only)
# CRITICAL: Must be set to "s3" for production deployment
RECORDING_STORAGE_MODE=s3

FRONTEND_URL=https://hurshbin.lumesoftai.in:3001

# Email Configuration (Brevo API)
# Get your API key from https://app.brevo.com/settings/keys/api
# BREVO_API_KEY is required for email functionality
BREVO_API_KEY=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
SENDER_NAME=Hurshbintech
SENDER_EMAIL=dhangarpratik5077@gmail.com
ENABLE_EMAIL=true
