[flake8]
max-line-length = 100
max-complexity = 15
extend-ignore = E203, E266, E501, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    alembic/,
    build,
    dist,
    .eggs,
    *.egg-info

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    app/api/endpoints/websocket.py:C901
    app/api/endpoints/vlogs.py:C901
