# Production Environment Variables for Frontend
# Copy this to hurshbin-deployment/hurshbintech-frontend/.env.production

# Backend API URL - Must match your backend domain
VITE_API_BASE_URL=https://hurshbin.com/api
VITE_API_TIMEOUT=30000

# WebSocket URL - Must match your backend domain
VITE_WS_URL=wss://hurshbin.com/ws


