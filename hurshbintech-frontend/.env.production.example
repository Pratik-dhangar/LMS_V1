# Production Environment Variables for Frontend
# Copy this to hurshbin-deployment/hurshbintech-frontend/.env.production

# Backend API URL - Use your EC2 public IP or domain
VITE_API_BASE_URL=http://43.204.218.16/api
VITE_API_TIMEOUT=30000

# WebSocket URL - Use your EC2 public IP or domain
VITE_WS_URL=ws://43.204.218.16/ws

# If using domain with SSL:
# VITE_API_BASE_URL=https://yourdomain.com/api
# VITE_WS_URL=wss://yourdomain.com/ws

# Optional: Analytics, monitoring, etc.
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
