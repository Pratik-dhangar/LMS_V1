# Production Environment Variables for Frontend
# Copy this to hurshbin-deployment/hurshbintech-frontend/.env.production

# Backend API URL - Must match your backend domain (port 8000 for API)
VITE_API_BASE_URL=https://hurshbin.com:8000/api
VITE_API_TIMEOUT=30000

# WebSocket URL - Must match your backend domain (port 8000 for WebSocket)
VITE_WS_URL=wss://hurshbin.com:8000/ws


