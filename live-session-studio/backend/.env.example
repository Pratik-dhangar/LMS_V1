# Live Session Studio Backend - Environment Configuration
# Copy to .env and edit values

# --- Database (PostgreSQL - MUST use the LMS project's PostgreSQL cluster) ---
# The LMS project's PostgreSQL is at .local-setup/tools/postgresql/pgsql/bin/ port 5432
# Create the live_session_studio database in that cluster (see setup-local.bat)
DATABASE_URL=postgresql://lss_user:lss_local_pass@127.0.0.1:5432/live_session_studio

# --- Security (auto-generated on first run if empty) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FILE_SIGNING_SECRET=

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]

# --- Storage ---
UPLOADS_DIR=uploads
RECORDINGS_DIR=uploads/recordings

# --- FFmpeg (available via winget) ---
FFMPEG_PATH=ffmpeg

# --- ICE Servers (JSON array) ---
ICE_SERVERS_JSON=[{"urls": ["stun:stun.l.google.com:19302"]}]
